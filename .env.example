MONGODB_URI=mongodb://mongo:27017/crewforge?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3002
SEED_HACKATHON_ID=hack4hack-crew-hiring-2026
NEXT_PUBLIC_HACKATHON_ID=hack4hack-crew-hiring-2026

# Use separate unique values for fixture users and judge-only demo accounts.
SEED_DEMO_PASSWORD=
JUDGE_DEMO_PASSWORD=

# Optional: leave empty to keep email verification/recovery disabled locally.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAILS=

# Self-hosted production only: set this only to a header overwritten by your trusted reverse proxy.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Optional private webhook for threshold alerts.
# SECURITY_ALERT_WEBHOOK=

# Set true only when a verified transactional email sender is configured.
AUTH_EMAIL_VERIFICATION_REQUIRED=false
